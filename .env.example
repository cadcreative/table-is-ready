# Server
PORT=3000
# DATABASE_PATH=./data/table-is-ready.db

# Restaurant / message defaults (can also be changed on the Settings page; Settings page wins)
RESTAURANT_NAME=Our Restaurant
READY_MESSAGE_TEMPLATE=Hi {name}, your table at {restaurant} is ready! Please head to the host stand.
JOIN_MESSAGE_TEMPLATE=You're on the waitlist at {restaurant}. We'll text you when your table is ready.
JOIN_SMS_ENABLED=false

# Twilio — leave blank to run in DEMO mode (texts are logged, not sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Force demo mode even if Twilio vars are set:
# SMS_PROVIDER=demo
